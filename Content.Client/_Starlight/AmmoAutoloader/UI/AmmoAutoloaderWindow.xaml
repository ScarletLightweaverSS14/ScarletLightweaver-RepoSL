<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
               Title="{Loc ammo-autoloader-title}"
               MinSize="520 340"
               SetSize="520 340">
    <BoxContainer Orientation="Vertical" Margin="8 8 8 8" SeparationOverride="6">

        <!-- Jam warning banner -->
        <PanelContainer Name="JamBanner" Visible="False">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#7a1818" />
            </PanelContainer.PanelOverride>
            <Label Name="JamLabel"
                   Text="{Loc ammo-autoloader-jammed-banner}"
                   HorizontalAlignment="Center"
                   Margin="6 4 6 4"
                   StyleClasses="LabelKeyText" />
        </PanelContainer>

        <!-- Two-column layout -->
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="8">

            <!-- ──────────── SIDE 1 ──────────── -->
            <PanelContainer HorizontalExpand="True" VerticalExpand="True">
                <BoxContainer Orientation="Vertical" Margin="6 6 6 6" SeparationOverride="6">

                    <Label Text="{Loc ammo-autoloader-side-1-label}"
                           HorizontalAlignment="Center"
                           StyleClasses="LabelKeyText" />

                    <!-- Mag sprite preview -->
                    <PanelContainer MinSize="0 110" HorizontalExpand="True">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#1a1a1a" />
                        </PanelContainer.PanelOverride>
                        <SpriteView Name="Side1MagSprite"
                                    Scale="4 4"
                                    OverrideDirection="South"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                    </PanelContainer>

                    <!-- Info panel -->
                    <BoxContainer Orientation="Vertical" SeparationOverride="2">
                        <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                            <Label Text="{Loc ammo-autoloader-mag-label}"
                                   StyleClasses="LabelSubText"
                                   MinWidth="80" />
                            <Label Name="Side1MagName"
                                   Text="{Loc ammo-autoloader-empty}"
                                   HorizontalExpand="True" />
                        </BoxContainer>

                        <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                            <Label Text="{Loc ammo-autoloader-ammo-label}"
                                   StyleClasses="LabelSubText"
                                   MinWidth="80" />
                            <Label Name="Side1AmmoName"
                                   Text="{Loc ammo-autoloader-empty}"
                                   HorizontalExpand="True" />
                        </BoxContainer>

                        <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                            <Label Text="{Loc ammo-autoloader-compat-label}"
                                   StyleClasses="LabelSubText"
                                   MinWidth="80" />
                            <Label Name="Side1CompatLabel"
                                   Text="{Loc ammo-autoloader-compat-unknown}"
                                   HorizontalExpand="True" />
                        </BoxContainer>

                        <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                            <Label Text="{Loc ammo-autoloader-status-label}"
                                   StyleClasses="LabelSubText"
                                   MinWidth="80" />
                            <Label Name="Side1StatusLabel"
                                   Text="{Loc ammo-autoloader-status-idle}"
                                   HorizontalExpand="True" />
                        </BoxContainer>
                    </BoxContainer>

                    <!-- Eject row -->
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="4">
                        <Button Name="Side1EjectMagButton"
                                Text="{Loc ammo-autoloader-eject-mag}"
                                HorizontalExpand="True" />
                        <Button Name="Side1EjectAmmoButton"
                                Text="{Loc ammo-autoloader-eject-ammo}"
                                HorizontalExpand="True" />
                    </BoxContainer>

                    <!-- Auto-load toggle -->
                    <Button Name="Side1ToggleButton"
                            Text="{Loc ammo-autoloader-autoload-off}"
                            HorizontalExpand="True"
                            ToggleMode="True" />
                </BoxContainer>
            </PanelContainer>

            <!-- ──────────── SIDE 2 ──────────── -->
            <PanelContainer HorizontalExpand="True" VerticalExpand="True">
                <BoxContainer Orientation="Vertical" Margin="6 6 6 6" SeparationOverride="6">

                    <Label Text="{Loc ammo-autoloader-side-2-label}"
                           HorizontalAlignment="Center"
                           StyleClasses="LabelKeyText" />

                    <!-- Mag sprite preview -->
                    <PanelContainer MinSize="0 110" HorizontalExpand="True">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#1a1a1a" />
                        </PanelContainer.PanelOverride>
                        <SpriteView Name="Side2MagSprite"
                                    Scale="4 4"
                                    OverrideDirection="South"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                    </PanelContainer>

                    <!-- Info panel -->
                    <BoxContainer Orientation="Vertical" SeparationOverride="2">
                        <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                            <Label Text="{Loc ammo-autoloader-mag-label}"
                                   StyleClasses="LabelSubText"
                                   MinWidth="80" />
                            <Label Name="Side2MagName"
                                   Text="{Loc ammo-autoloader-empty}"
                                   HorizontalExpand="True" />
                        </BoxContainer>

                        <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                            <Label Text="{Loc ammo-autoloader-ammo-label}"
                                   StyleClasses="LabelSubText"
                                   MinWidth="80" />
                            <Label Name="Side2AmmoName"
                                   Text="{Loc ammo-autoloader-empty}"
                                   HorizontalExpand="True" />
                        </BoxContainer>

                        <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                            <Label Text="{Loc ammo-autoloader-compat-label}"
                                   StyleClasses="LabelSubText"
                                   MinWidth="80" />
                            <Label Name="Side2CompatLabel"
                                   Text="{Loc ammo-autoloader-compat-unknown}"
                                   HorizontalExpand="True" />
                        </BoxContainer>

                        <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                            <Label Text="{Loc ammo-autoloader-status-label}"
                                   StyleClasses="LabelSubText"
                                   MinWidth="80" />
                            <Label Name="Side2StatusLabel"
                                   Text="{Loc ammo-autoloader-status-idle}"
                                   HorizontalExpand="True" />
                        </BoxContainer>
                    </BoxContainer>

                    <!-- Eject row -->
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="4">
                        <Button Name="Side2EjectMagButton"
                                Text="{Loc ammo-autoloader-eject-mag}"
                                HorizontalExpand="True" />
                        <Button Name="Side2EjectAmmoButton"
                                Text="{Loc ammo-autoloader-eject-ammo}"
                                HorizontalExpand="True" />
                    </BoxContainer>

                    <!-- Auto-load toggle -->
                    <Button Name="Side2ToggleButton"
                            Text="{Loc ammo-autoloader-autoload-off}"
                            HorizontalExpand="True"
                            ToggleMode="True" />
                </BoxContainer>
            </PanelContainer>

        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
