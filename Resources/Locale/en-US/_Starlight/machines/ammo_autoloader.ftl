## Ammo Autoloader machine

ammo-autoloader-title = Ammo Autoloader

# Slot names (shown in item-slot tooltips)
ammo-autoloader-mag-slot-1  = Magazine Slot 1
ammo-autoloader-mag-slot-2  = Magazine Slot 2
ammo-autoloader-ammo-slot-1 = Ammo Box Slot 1
ammo-autoloader-ammo-slot-2 = Ammo Box Slot 2

# Window labels
ammo-autoloader-side-1-label = — Side 1 —
ammo-autoloader-side-2-label = — Side 2 —
ammo-autoloader-mag-label    = Magazine:
ammo-autoloader-ammo-label   = Ammo Box:
ammo-autoloader-compat-label = Compatible:
ammo-autoloader-status-label = Status:

# Values
ammo-autoloader-empty           = (empty)
ammo-autoloader-compat-unknown  = —
ammo-autoloader-compat-yes      = YES
ammo-autoloader-compat-no       = NO – MISMATCH

# Status values
ammo-autoloader-status-idle    = Idle
ammo-autoloader-status-loading = Loading...
ammo-autoloader-status-jammed  = JAMMED

# Buttons
ammo-autoloader-autoload-off = Auto-Load: OFF
ammo-autoloader-autoload-on  = Auto-Load: ON
ammo-autoloader-eject-mag    = Eject Mag
ammo-autoloader-eject-ammo   = Eject Box

# Jam banner
ammo-autoloader-jammed-banner =  MACHINE JAMMED — Open panel (screwdriver), then clear jam (crowbar)

# Popups
ammo-autoloader-jammed        = Side {$side}: JAMMED! Wrong ammo type. Open the panel and crowbar out the jam.
ammo-autoloader-need-panel-open = The maintenance panel must be open first. Use a screwdriver.
ammo-autoloader-unjammed      = Jam cleared. Remove the incompatible ammo box before restarting.
ammo-autoloader-side-full     = Side {$side}: Magazine is full. Auto-load disabled.
ammo-autoloader-side-empty    = Side {$side}: Ammo box is empty. Auto-load disabled.
ammo-autoloader-mag-slot-wrong-item = Side {$side}: Mag slot contains an ammo box — use the ammo box slot!
