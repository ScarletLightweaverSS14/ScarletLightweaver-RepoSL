firing-pin-crystal-heat-critical = The crystal is [color=red]dangerously overheated[/color]!

firing-pin-crystal-degraded-low = It has [color=yellow]minor cracks[/color] from overheating.
firing-pin-crystal-degraded-medium = It has [color=orange]significant fractures[/color] from repeated overheating.
firing-pin-crystal-degraded-high = It is [color=red]severely fractured[/color] — one more overheat will shatter it!

firing-pin-crystal-shots-until-break =
    { $shots ->
        [one] [color=red]1[/color] more overheated shot until it shatters!
       *[other] [color=red]{ $shots }[/color] overheated shots until it shatters!
    }
